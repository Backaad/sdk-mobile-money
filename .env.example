# sdk-mobile-money: environment variables
#
# Copy this file to `.env` (ignored by git) and fill in your own SANDBOX values.
# Never commit a real key, and never paste one in an issue or a pull request.
#
# The project has no keys of its own: every developer uses their own sandbox
# accounts. Sandbox tests run only when the variables of their provider are
# set in the environment (for example: set -a; . ./.env; set +a); otherwise
# they are skipped. The CI runs without any key.
#
# Anything marked "to be confirmed" has not been checked yet against the
# provider's official documentation.

# --- MTN MoMo (public sandbox: https://sandbox.momodeveloper.mtn.com) --------
# "sandbox" or "production". Required as soon as an MTN MoMo variable is set.
MTN_MOMO_ENVIRONMENT=
# Each product (collection, disbursement) has its own subscription key,
# API user and API key.
MTN_MOMO_COLLECTION_SUBSCRIPTION_KEY=
MTN_MOMO_COLLECTION_API_USER=
MTN_MOMO_COLLECTION_API_KEY=
MTN_MOMO_DISBURSEMENT_SUBSCRIPTION_KEY=
MTN_MOMO_DISBURSEMENT_API_USER=
MTN_MOMO_DISBURSEMENT_API_KEY=
# "sandbox" for the public sandbox. Production name for Cameroon: to be confirmed.
MTN_MOMO_TARGET_ENVIRONMENT=sandbox
# Optional: the account currency (XAF by default). The public sandbox only
# accepts EUR (to be confirmed).
MTN_MOMO_CURRENCY=

# --- Campay (sandbox: https://demo.campay.net) ------------------------------
# "sandbox" or "production". Required as soon as a Campay variable is set.
CAMPAY_ENVIRONMENT=
# Application username and password, used to get an access token.
CAMPAY_USERNAME=
CAMPAY_PASSWORD=
# Application webhook key, used to verify the webhook signature (JWT HS256;
# scheme to be confirmed, see docs/providers/campay.md).
CAMPAY_WEBHOOK_KEY=
# Optional: a sandbox phone number (237XXXXXXXXX) for the sandbox collection test.
# Its owner receives a payment prompt for 5 XAF.
CAMPAY_SANDBOX_PHONE_NUMBER=

# --- NotchPay (https://api.notchpay.co) -------------------------------------
# Test public keys start with pk_test_.
NOTCHPAY_PUBLIC_KEY=
# Optional private key, sent in the X-Grant header; needed for payouts
# (transfers). To be confirmed: whether the charge needs it too.
NOTCHPAY_PRIVATE_KEY=
# Secret used to verify the x-notch-signature HMAC-SHA256. Its name in the
# NotchPay dashboard is to be confirmed.
NOTCHPAY_WEBHOOK_SECRET=

# --- Tara (experimental) ----------------------------------------------------
# The API key travels in the request body: such bodies are never logged.
TARA_API_KEY=
TARA_BUSINESS_ID=
# Optional: comma-separated IP addresses allowed to send Tara callbacks.
TARA_CALLBACK_ALLOWED_IPS=

# --- Demo server (examples/spring-boot-demo) ---------------------------------
# true: the demo talks to nobody. Set false to use the keys above.
MOBILE_MONEY_SIMULATION=true
# Provider used first when several are configured: campay, mtn-momo, notchpay, tara.
MOBILE_MONEY_DEFAULT_PROVIDER=
# Public HTTPS URL of the demo's /mobile-money/webhooks (for example a tunnel).
MOBILE_MONEY_CALLBACK_BASE_URL=
# Currency of the demo's payments: XAF by default; EUR for the MTN MoMo public
# sandbox (to be confirmed), with MTN_MOMO_CURRENCY=EUR.
DEMO_CURRENCY=
